FROM node:20-bookworm-slim AS deps
WORKDIR /app
ENV HUSKY=0
COPY package.json package-lock.json ./
RUN npm ci

FROM node:20-bookworm-slim AS builder
WORKDIR /app
ENV HUSKY=0
ENV NEXT_TELEMETRY_DISABLED=1

ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_USE_MOCK=false
ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_SITE_SEARCH_URL_TEMPLATE
ARG NEXT_PUBLIC_GA_ID
ARG NEXT_PUBLIC_ANALYTICS_PROVIDER=ga
ARG NEXT_PUBLIC_YANDEX_METRIKA_ID
ARG TOUR_PACKS_API_URL
ARG TOUR_PACKS_MANIFEST
ARG FORCE_TOUR_PACKS
ARG GOOGLE_SITE_VERIFICATION
ARG YANDEX_VERIFICATION
ARG ORGANIZATION_SAME_AS
ARG ADDITIONAL_SITEMAP_URLS

ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
	NEXT_PUBLIC_USE_MOCK=$NEXT_PUBLIC_USE_MOCK \
	NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL \
	NEXT_PUBLIC_SITE_SEARCH_URL_TEMPLATE=$NEXT_PUBLIC_SITE_SEARCH_URL_TEMPLATE \
	NEXT_PUBLIC_GA_ID=$NEXT_PUBLIC_GA_ID \
	NEXT_PUBLIC_ANALYTICS_PROVIDER=$NEXT_PUBLIC_ANALYTICS_PROVIDER \
	NEXT_PUBLIC_YANDEX_METRIKA_ID=$NEXT_PUBLIC_YANDEX_METRIKA_ID \
	TOUR_PACKS_API_URL=$TOUR_PACKS_API_URL \
	TOUR_PACKS_MANIFEST=$TOUR_PACKS_MANIFEST \
	FORCE_TOUR_PACKS=$FORCE_TOUR_PACKS \
	GOOGLE_SITE_VERIFICATION=$GOOGLE_SITE_VERIFICATION \
	YANDEX_VERIFICATION=$YANDEX_VERIFICATION \
	ORGANIZATION_SAME_AS=$ORGANIZATION_SAME_AS \
	ADDITIONAL_SITEMAP_URLS=$ADDITIONAL_SITEMAP_URLS

COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run build

FROM node:20-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production \
	NEXT_TELEMETRY_DISABLED=1 \
	HOSTNAME=0.0.0.0 \
	PORT=3000

RUN groupadd --system --gid 1001 nodejs \
	&& useradd --system --uid 1001 --gid nodejs nextjs

COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/public ./public

USER nextjs
EXPOSE 3000
CMD ["node", "server.js"]
